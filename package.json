{
  "name": "@local/dsh-graphify",
  "version": "0.2.0",
  "private": true,
  "description": "Graphify integration for DeepSeek Harness: graphify_* agent tools + interactive code-graph sidebar tab",
  "license": "MIT",
  "author": "b-iurea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b-iurea/dsh-graphify.git"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "graphify",
    "knowledge-graph",
    "code-graph"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/it.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
